@@ -32,6 +32,11 @@ std::array<float, kMaxLights * 8> g_lights{};
 uint32_t g_lightCount = 0;
 float g_edgeStrength = 0.4f;  // how bright a sunlit edge gets
 float g_sunStrength = 0.35f;  // how dark a sun shadow is
