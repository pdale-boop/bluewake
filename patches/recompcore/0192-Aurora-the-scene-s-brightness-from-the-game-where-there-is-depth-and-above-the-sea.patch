       .primitive = {.topology = wgpu::PrimitiveTopology::TriangleList},
@@ -1713,6 +1747,7 @@ void ensure_targets(const wgpu::Extent3D& sceneSize, wgpu::TextureFormat format,
     g_torchPass = {};
