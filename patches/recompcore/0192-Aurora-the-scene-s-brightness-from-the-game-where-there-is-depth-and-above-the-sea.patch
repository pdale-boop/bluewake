     g_size = {};
   }
@@ -1749,6 +1784,7 @@ void ensure_targets(const wgpu::Extent3D& sceneSize, wgpu::TextureFormat format,
   }
   if (!g_farComposite || samples != g_farSamples) {
     g_farComposite = make_far_pipeline(format, samples);
