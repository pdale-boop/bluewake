@@ -125,6 +130,7 @@ wgpu::Sampler g_sampler;
 wgpu::TextureFormat g_format = wgpu::TextureFormat::Undefined;
 wgpu::RenderPipeline g_bright, g_blurH, g_blurV;
 wgpu::RenderPipeline g_composite;
